# Server configuration
PORT=3000
GEMINI_API_KEY=

# Admin Notifications (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase and Auth
ADMIN_EMAIL=
# PHẢI trùng firebaseConfig.projectId trong gui/index.html, nếu không mọi ID token
# đều verify thất bại và người dùng PRO bị hạ xuống 'guest'.
# Kiểm tra giá trị đang chạy: GET /ping
FIREBASE_PROJECT_ID=phmix-studio
FIRESTORE_DATABASE_ID=

# Host được phép tải ảnh cho ngân hàng câu hỏi (phân tách bằng dấu phẩy).
# Để trống là đủ trong hầu hết trường hợp: firebasestorage.googleapis.com,
# storage.googleapis.com và bucket của dự án đã được cho phép sẵn.
# Chỉ thêm host khi ảnh trong đề bị bỏ qua kèm log "URL ảnh không nằm trong danh sách cho phép".
MEDIA_ALLOWED_HOSTS=
