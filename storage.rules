rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for user-scoped images
    match /users/{userId}/images/{allImages=**} {
      // Allow public read for images rendered in questions and exams
      allow read: if request.auth != null;
      // Allow write for owner only
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default rule for all other user-scoped storage paths
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
